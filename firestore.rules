rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organizations and all their subcollections (branches, registers, products, sales, etc.)
    match /organizations/{orgId} {
      allow read, write: if true;

      match /{subcollection}/{document=**} {
        allow read, write: if true;
      }
    }

    // User profiles & store staff
    match /users/{userId} {
      allow read, write: if true;
    }

    // Top-level collections for direct POS data sync & Firebase Console browsing
    match /customers/{customerId} { allow read, write: if true; }
    match /customer_ledger/{ledgerId} { allow read, write: if true; }
    match /products/{productId} { allow read, write: if true; }
    match /categories/{categoryId} { allow read, write: if true; }
    match /sales/{saleId} { allow read, write: if true; }
    match /sale_items/{itemId} { allow read, write: if true; }
    match /sale_payments/{paymentId} { allow read, write: if true; }
    match /item_barcodes/{barcodeId} { allow read, write: if true; }
    match /stock_movements/{movementId} { allow read, write: if true; }
    match /shifts/{shiftId} { allow read, write: if true; }
    match /shift_denominations/{shiftId} { allow read, write: if true; }
    match /cash_movements/{movementId} { allow read, write: if true; }
    match /store_settings/{settingId} { allow read, write: if true; }
    match /audit_logs/{logId} { allow read, write: if true; }
    match /held_orders/{orderId} { allow read, write: if true; }
    match /branches/{branchId} { allow read, write: if true; }
    match /registers/{registerId} { allow read, write: if true; }
    match /staff_members/{staffId} { allow read, write: if true; }
    match /fiscal_years/{fiscalYearId} { allow read, write: if true; }

    match /devices/{deviceId} { allow read, write: if true; }
    match /invitations/{invitationId} { allow read, write: if true; }
    match /memberships/{membershipId} { allow read, write: if true; }
    match /tax_rates/{taxRateId} { allow read, write: if true; }
    match /customer_credit_terms/{termId} { allow read, write: if true; }
    match /price_history/{historyId} { allow read, write: if true; }
    match /shift_cash_counts/{countId} { allow read, write: if true; }
    match /shift_declarations/{declId} { allow read, write: if true; }
    match /shift_credit_notes/{noteId} { allow read, write: if true; }
    match /shift_adjustments/{adjId} { allow read, write: if true; }
    match /shift_versions/{verId} { allow read, write: if true; }
    match /shift_events/{eventId} { allow read, write: if true; }

    // Universal catch-all for any other store collections
    match /{collection}/{docId} {
      allow read, write: if true;
    }
  }
}
